# Copia questo file in `.env` e compila i valori.
# `.env` non va MAI committato (vedi .gitignore).

# true  -> l'app gira su dati finti in memoria, nessun backend necessario.
# false -> l'app parla con Supabase usando le due variabili qui sotto.
VITE_USE_FIXTURES=true

# Dashboard Supabase -> Project Settings -> API
# La anon key è pubblica per definizione (finisce nel bundle del browser):
# è la Row Level Security a proteggere i dati, non la segretezza di questa chiave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copia questo file in `.env` e compila i valori.
# `.env` non va MAI committato (vedi .gitignore).

# true  -> l'app gira su dati finti in memoria, nessun backend necessario.
# false -> l'app parla con Supabase usando le due variabili qui sotto.
VITE_USE_FIXTURES=false

# Dashboard Supabase -> Project Settings -> API Keys
# In VITE_SUPABASE_ANON_KEY va la publishable key (sb_publishable_...), o la
# vecchia anon key sui progetti che ce l'hanno ancora. È pubblica per
# definizione (finisce nel bundle del browser): è la Row Level Security a
# proteggere i dati. La secret key (sb_secret_...) non va MAI qui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
